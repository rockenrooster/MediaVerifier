<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MediaVerifier</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Framework-dependent (D-01): the installed .NET 10 Desktop Runtime (x64) is a prerequisite. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools\New-AppIcon.ps1 from the geometry in subplan 08; never edit by hand. -->
    <ApplicationIcon>Assets\MediaVerifier.ico</ApplicationIcon>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <!-- WFO1000 is about Windows Forms designer serialisation; every control here is built in code. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaVerifier.Core\MediaVerifier.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MediaVerifier.Tests" />
  </ItemGroup>

  <!-- Debug builds run with the bundled media engine (deps\ffmpeg\bin, fetched by scripts\Get-FfmpegBundle.ps1), so Scan
       works in a development build. A target, not content items: test projects that reference this one must not get a
       copy (AppContext.BaseDirectory\ffmpeg would change which engine the tests use). -->
  <Target Name="CopyDevFfmpegBundle" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And Exists('$(MSBuildThisFileDirectory)..\..\deps\ffmpeg\bin\bundle.json')">
    <ItemGroup>
      <DevFfmpegFile Include="$(MSBuildThisFileDirectory)..\..\deps\ffmpeg\bin\*" Exclude="$(MSBuildThisFileDirectory)..\..\deps\ffmpeg\bin\.lock-sha256" />
    </ItemGroup>
    <Copy SourceFiles="@(DevFfmpegFile)" DestinationFolder="$(OutDir)ffmpeg" SkipUnchangedFiles="true" />
  </Target>

</Project>
