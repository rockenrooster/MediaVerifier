    "libhwy-contrib": { "same": "libhwy" },
    "libbrotlicommon": { "name": "Brotli", "licence": "MIT", "urls": ["https://raw.githubusercontent.com/google/brotli/v{version}/LICENSE", "https://raw.githubusercontent.com/google/brotli/master/LICENSE"] },
